rule Browser_Extension_Cookie_Exfil_XOR_Encoded
{
    strings:
        $cookies = "chrome.cookies.getAll" ascii
        $xor     = /charCodeAt\(\s*\w+\s*\)\s*\^\s*(0x[0-9a-fA-F]{1,2}|\d{1,3})/ ascii
        $btoa    = "btoa(" ascii
        $fetch   = "fetch(" ascii
    condition:
        filesize < 500KB and all of them
}

rule TabFlow_Pro_Background_Config
{
    strings:
        $c2_b64    = "aHR0cHM6Ly9hcGkudGFiZmxvdy1jZG4ubmV0" ascii
        $sync_b64  = "L2FwaS92Mi9zeW5j" ascii
        $reg_b64   = "L2FwaS92Mi9yZWdpc3Rlcg==" ascii
        $key_b64   = "dGYtMjAyNS14LW1hcmNoLWtleQ==" ascii
        $hdr       = "X-Client-Key" ascii
        $c2_plain  = "tabflow-cdn.net" ascii nocase
    condition:
        filesize < 500KB and ($c2_b64 or $c2_plain or 2 of ($sync_b64, $reg_b64, $key_b64, $hdr))
}